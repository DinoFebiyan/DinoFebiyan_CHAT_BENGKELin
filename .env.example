# Salin file ini menjadi .env lalu sesuaikan isinya.
# Untuk Vercel, isi nilai yang sama di Project Settings > Environment Variables.

# Postgres (Neon) — ambil POSTGRES_URL dari Vercel: Project > Storage > Database
# Format: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Batas koneksi pool (serverless disarankan 5)
DB_POOL=5

# Kunci penandatanganan cookie sesi (ganti dengan string acak yang panjang)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Port server lokal
PORT=3001
