{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["server.js", "src/**", "database/**", "scripts/**", "package.json"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*\\.(?:html|css|js|jpg|jpeg|png|webp|svg|gif|ico))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
